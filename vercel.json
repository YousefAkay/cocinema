{
  "redirects": [
    {
      "source": "/",
      "destination": "/src/"
    }
  ],
  "headers": [
    {
      "source": "/src/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
